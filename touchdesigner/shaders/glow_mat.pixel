// GLSL MAT pixel stage: emissive core + Fresnel rim light. Cheap (no light
// loop), looks expensive, and blooms beautifully through the scene's glow pass.

uniform float uLevel;
uniform float uBeat;

in Vertex {
    vec3 worldNorm;
    vec3 worldPos;
    vec4 color;
} iVert;

layout(location = 0) out vec4 fragColor[TD_NUM_COLOR_BUFFERS];

void main() {
    vec3 n = normalize(iVert.worldNorm);
    vec3 camPos = uTDMats[TDCameraIndex()].camInverse[3].xyz;
    vec3 viewDir = normalize(camPos - iVert.worldPos);

    float fres = pow(1.0 - max(dot(n, viewDir), 0.0), 2.0);
    float facing = max(dot(n, viewDir), 0.0);

    vec3 base = iVert.color.rgb;
    vec3 col = base * (0.45 + 0.7 * uLevel + 0.35 * facing);  // emissive core
    col += base * fres * (1.3 + uBeat);                       // bright rim
    col += fres * fres * vec3(1.0) * 0.15;                    // white-hot edge

    fragColor[0] = TDOutputSwizzle(vec4(col, 1.0));
}
